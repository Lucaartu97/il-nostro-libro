# Copia questo file in ".env" per lo sviluppo locale. In produzione (fly.io) questi valori
# si impostano con "fly secrets set" e nel fly.toml, mai in un file.

# Porta del server Express.
PORT=3000

# Connessione a PostgreSQL. Il valore qui sotto vale sia per "npm run dev" (database integrato)
# sia per "docker compose up db".
DATABASE_URL=postgres://libro:libro@localhost:5432/libro

# Segreto della app: firma le sessioni e protegge i codici di accesso dei libri.
# OBBLIGATORIO in produzione. Generane uno lungo e casuale, per esempio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ATTENZIONE: una volta creato il primo libro NON va più cambiato, o le chiavi smettono di funzionare.
APP_SECRET=

# Cartella dei file caricati (foto, video, audio). In produzione punta al volume persistente.
# UPLOAD_DIR=/percorso/assoluto/dei/file   (predefinito: server/uploads)

# Dimensione massima di ogni file caricato, in MB.
MAX_UPLOAD_MB=10

# Solo sviluppo: dove tenere i dati e su che porta avviare il PostgreSQL integrato ("npm run db:local").
# LOCAL_DB_DIR=
# LOCAL_DB_PORT=5432

# Solo sviluppo: indirizzo del server a cui Vite inoltra /api e i WebSocket.
# VITE_API_TARGET=http://localhost:3000
